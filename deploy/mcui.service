# microcloud-ui as a systemd service (docs/DEPLOY.md, D63). Installed by install.sh
# to /etc/systemd/system/mcui.service; local changes go in `systemctl edit mcui`.
[Unit]
Description=microcloud-ui (web UI and metrics for MicroCloud)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=mcui
Group=mcui
WorkingDirectory=/var/lib/mcui
ExecStart=/opt/mcui/current/bin/mcui -c /etc/mcui/config.toml serve
Restart=on-failure
RestartSec=5
# exit 2 is a config error: say so in the journal instead of restarting in a loop
RestartPreventExitStatus=2
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65536

# Sandboxing: writes only to /var/lib/mcui; reads its config; no privileges.
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/mcui
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
