#!/usr/bin/env bash
# Runs lint + tests with coverage gates before each commit. Install: make hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
email="$(git config user.email)"
if [ "$email" != "gareth@woolridge.org.uk" ]; then
  echo "pre-commit: commits must use gareth@woolridge.org.uk (got '$email')" >&2
  exit 1
fi
make lint test
